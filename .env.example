# Copy this file to .env and fill in your keys.
# The app runs with realistic sample data even without keys configured,
# so you can deploy and demo immediately, then wire in live data.

# Free, instant key: https://data.gov.in/user/register (then request API key)
DATA_GOV_IN_KEY=

# Free, instant key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Optional: pin a specific Gemini model. Defaults to gemini-flash-latest.
# GEMINI_MODEL=
# Optional: model tried if the primary is overloaded. Defaults to gemini-flash-lite-latest.
# GEMINI_BACKUP_MODEL=
